# Isolated ARM64 dependencies. Existing x64 pins remain intact.
function(bobtv_download_sha256 url destination digest)
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if(actual STREQUAL digest)
      return()
    endif()
    message(FATAL_ERROR "Cached ARM64 dependency checksum mismatch: ${destination}")
  endif()
  file(DOWNLOAD "${url}" "${destination}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON)
endfunction()
set(LIBMPV_SRC "${CMAKE_BINARY_DIR}/libmpv")
set(mpv_archive "${CMAKE_BINARY_DIR}/mpv-dev-aarch64-20241021-git-0f78584.7z")
bobtv_download_sha256("https://github.com/media-kit/libmpv-win32-video-cmake/releases/download/20241021/mpv-dev-aarch64-20241021-git-0f78584.7z"
  "${mpv_archive}" "d445d02ab2ee60b1b5988f08ce4d2394cdcc594e98321b746a313313e96133ae")
file(MAKE_DIRECTORY "${LIBMPV_SRC}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xvf "${mpv_archive}" WORKING_DIRECTORY "${LIBMPV_SRC}" RESULT_VARIABLE extracted OUTPUT_QUIET)
if(NOT extracted EQUAL 0)
  message(FATAL_ERROR "ARM64 libmpv extraction failed")
endif()
file(COPY "${LIBMPV_SRC}/include/mpv/" DESTINATION "${LIBMPV_SRC}/include")
set(angle_archive "${CMAKE_BINARY_DIR}/angle-arm64-2026-10-11.zip")
bobtv_download_sha256("https://github.com/mmozeiko/build-angle/releases/download/2026-10-11/angle-arm64-2026-10-11.zip"
  "${angle_archive}" "15a036bcd95022e64f8fcaddd8e492b978d7deb1afb22c77deda40755026fa97")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/ANGLE")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xvf "${angle_archive}" WORKING_DIRECTORY "${CMAKE_BINARY_DIR}/ANGLE" RESULT_VARIABLE extracted OUTPUT_QUIET)
if(NOT extracted EQUAL 0)
  message(FATAL_ERROR "ARM64 ANGLE extraction failed")
endif()
set(BOBTV_ANGLE_SRC "${CMAKE_BINARY_DIR}/ANGLE/angle-arm64" CACHE INTERNAL "Architecture-specific ANGLE path" FORCE)
