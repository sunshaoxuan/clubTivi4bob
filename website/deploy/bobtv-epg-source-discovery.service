[Unit]
Description=BobTV bounded channel-first automatic identity and EPG source search
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bobtv
Group=bobtv
WorkingDirectory=/opt/bobtv/site
Environment=BOBTV_DATA_DIR=/var/lib/bobtv
ExecStart=/opt/bobtv/venv/bin/python /opt/bobtv/site/epg_auto_search_worker.py --max-channels 3
TimeoutStartSec=180
MemoryMax=384M
CPUQuota=15%
TasksMax=16
Nice=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bobtv
