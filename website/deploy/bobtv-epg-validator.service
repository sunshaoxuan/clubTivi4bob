[Unit]
Description=BobTV bounded EPG source validation and health checkpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bobtv
Group=bobtv
WorkingDirectory=/opt/bobtv/site
Environment=BOBTV_DATA_DIR=/var/lib/bobtv
ExecStart=/opt/bobtv/venv/bin/python /opt/bobtv/site/epg_ingest.py
TimeoutStartSec=90
MemoryMax=384M
CPUQuota=20%
TasksMax=16
Nice=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bobtv
