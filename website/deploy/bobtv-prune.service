[Unit]
Description=Prune expired BobTV diagnostic uploads

[Service]
Type=oneshot
User=bobtv
Group=bobtv
WorkingDirectory=/opt/bobtv/site
Environment=BOBTV_DATA_DIR=/var/lib/bobtv
ExecStart=/opt/bobtv/venv/bin/python prune.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bobtv
