[Unit]
Description=BobTV bounded channel-specific public route rescue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bobtv
Group=bobtv
WorkingDirectory=/opt/bobtv/site
Environment=BOBTV_DATA_DIR=/var/lib/bobtv
Environment=BOBTV_ROUTE_DECODER=/opt/bobtv/tools/route-recovery/ffmpeg
ExecStart=/opt/bobtv/venv/bin/python /opt/bobtv/site/channel_route_recovery.py --limit 1
TimeoutStartSec=150
MemoryMax=256M
CPUQuota=15%
TasksMax=24
Nice=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bobtv

